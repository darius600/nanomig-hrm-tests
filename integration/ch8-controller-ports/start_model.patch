+// Reset interval after a POTGO write with START: for eight lines the pot
+// lines that are inputs read 0 in POTGOR.
+reg [3:0] potrst;
+always @ (posedge clk) begin
+  if (clk7_en) begin
+    if (reset) potrst <= 4'd0;
+    else if (potreg[0]) potrst <= 4'd8;
+    else if (pot_cnt_en && potrst != 4'd0) potrst <= potrst - 4'd1;
+  end
+end
+wire [3:0] potdump = (potrst != 4'd0) ? ~{potreg[15], potreg[13], potreg[11], potreg[9]} : 4'b0000;
+
 wire joy2_pin5 = ~(potreg[13] & ~potreg[12]);
 wire joy1_pin5 = ~(potreg[9]  & ~potreg[8]);
 
