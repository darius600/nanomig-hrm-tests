--- a/cia_timerb.v
+++ b/cia_timerb.v
@@ -11,6 +11,8 @@
   output   [7:0] data_out,      // bus data out
   input  eclk,            // count enable
   input  tmra_ovf,        // timer A underflow
+  input  cnt,             // one clk7_en period per positive transition on CNT
+  input  cnth,            // CNT level
   output  irq            // intterupt out
 );
 
@@ -28,7 +30,8 @@
 wire  count;          // count enable signal
 
 // Timer B count signal source
-assign count = tmcr[6] ? tmra_ovf : eclk;
+// CRB bits 6-5 (p. 349): 00 phi2, 01 positive CNT transitions, 10 timer A underflows, 11 timer A underflows while CNT is high
+assign count = (tmcr[6:5] == 2'b00) ? eclk : (tmcr[6:5] == 2'b01) ? cnt : (tmcr[6:5] == 2'b10) ? tmra_ovf : (tmra_ovf & cnth);
 
 // writing timer control register
 always @(posedge clk)
