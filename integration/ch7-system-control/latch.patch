+// private copy: light-pen latch (HRM pp.238-239). LPEN (BPLCON0 bit 3) enables the input.
+// A falling edge of pin 6 after vertical position 20 freezes {vpos,hpos}; with no trigger the
+// counters latch at the end of the field; the freeze is released at vertical position 20.
+// While frozen, VPOSR/VHPOSR return the latched value unless ECS LPENDIS (BEAMCON0 bit 13, p.305).
+always @(posedge clk) begin
+	if (clk7_en) begin
+		lp_d <= _lp;
+		if (reset)
+			lp_en <= 1'b0;
+		else if (reg_address_in[8:1]==BPLCON0[8:1])
+			lp_en <= data_in[3];
+		if (reset)
+			lp_latched <= 1'b0;
+		else if (lp_latched && vpos==11'd20)
+			lp_latched <= 1'b0;
+		else if (!lp_latched && lp_en && lp_d && !_lp && vpos>11'd20) begin
+			lp_latched <= 1'b1;
+			lp_vpos <= vpos;
+			lp_hpos <= hpos;
+		end else if (!lp_latched && lp_en && end_of_frame) begin
+			lp_latched <= 1'b1;
+			lp_vpos <= vpos;
+			lp_hpos <= hpos;
+		end
+	end
+end
+
+assign lp_show = lp_latched && !(ecs && beamcon0_reg[13]);
+
 endmodule
