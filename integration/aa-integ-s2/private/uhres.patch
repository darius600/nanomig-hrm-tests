+// UHRES dma engine of the page-built private copy (AA pp. 6, 10, 15, 16, 22, 27, 28)
+module agnus_uhres
+(
+	input         clk,
+	input         clk7_en,
+	input         reset,
+	input   [8:0] hpos,            // main horizontal beam counter
+	input  [10:0] vpos,            // vertical beam counter
+	input         dual,            // BEAMCON0 DUAL
+	input   [7:0] hhpos,           // alternate horizontal beam counter
+	input         dmaen,           // DMACON DMAEN
+	input         busy,            // a higher priority channel uses this slot
+	input   [8:1] reg_address_in,
+	input  [15:0] data_in,
+	output        dma,
+	output [20:1] address_out,
+	output  [8:1] rga              // BPLHDAT (07A) with the bit plane pointer, SPRHDAT (078) with the sprite pointer
+);
+
+reg        uhres;
+reg [10:0] sstrt, sstop, bstrt, bstop;
+reg [15:0] bmod;
+reg [20:1] bpt, spt;
+
+always @(posedge clk) begin
+	if (clk7_en) begin
+		if (reset) begin
+			uhres <= 1'b0;
+		end else begin
+			case (reg_address_in[8:1])
+				8'h80: uhres <= data_in[7];                   // BPLCON0 bit 7
+				8'hE8: sstrt <= data_in[10:0];                // SPRHSTRT 1D0
+				8'hE9: sstop <= data_in[10:0];                // SPRHSTOP 1D2
+				8'hEA: bstrt <= data_in[10:0];                // BPLHSTRT 1D4
+				8'hEB: bstop <= data_in[10:0];                // BPLHSTOP 1D6
+				8'hF3: bmod  <= data_in[15:0];                // BPLHMOD  1E6
+				8'hF4: spt[20:16] <= data_in[4:0];            // SPRHPTH  1E8
+				8'hF5: spt[15:1]  <= data_in[15:1];           // SPRHPTL  1EA
+				8'hF6: bpt[20:16] <= data_in[4:0];            // BPLHPTH  1EC
+				8'hF7: bpt[15:1]  <= data_in[15:1];           // BPLHPTL  1EE
+				default: ;
+			endcase
+		end
+	end
+end
+
+// the chain restarts at the line start of the counter in use (AA p.12 DUAL)
+wire arm = hpos[0] && (dual ? (hhpos == 8'd0) : (hpos[8:1] == 8'd0));
+
+reg [1:0] cnt;      // free cycles seen since the restart: 0, 1, 2; 3 = chain finished
+reg       on, lb, ls;
+
+wire slot = hpos[0] && on && (cnt != 2'd3);
+wire free = slot && !busy;
+
+assign dma = free && ((cnt == 2'd0 && ls) || (cnt == 2'd1 && lb) || (cnt == 2'd2 && ls));
+assign address_out = (cnt == 2'd1) ? bpt : spt;
+assign rga = (cnt == 2'd1) ? 8'h3D : 8'h3C;
+
+always @(posedge clk) begin
+	if (clk7_en) begin
+		if (arm) begin
+			cnt <= 2'd0;
+			on  <= uhres && dmaen;
+			lb  <= (vpos >= bstrt) && (vpos < bstop);
+			ls  <= (vpos >= sstrt) && (vpos < sstop);
+		end else if (free) begin
+			cnt <= cnt + 2'd1;
+		end
+		if (dma && !arm) begin
+			if (cnt == 2'd1) bpt <= bpt + 20'd1 + {{5{bmod[15]}}, bmod[15:1]};
+			else             spt <= spt + 20'd1;
+		end
+	end
+end
+
+endmodule
