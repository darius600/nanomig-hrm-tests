+wire        busy_late = (busy_cnt >= 16'd1500);
+always @(posedge clk) busy_cnt <= blit_busy ? (busy_late ? busy_cnt : busy_cnt + 16'd1) : 16'd0;
 
 //data out multiplexer
 assign data_out = data_bmc | dmaconr | data_blt;
 
 //dma control register read
 always @(*) begin
-	if (reg_address[8:1]==DMACONR[8:1]) dmaconr[15:0] = {1'b0, blit_busy, blit_zero, dmacon[12:0]};
+	if (reg_address[8:1]==DMACONR[8:1]) dmaconr[15:0] = {1'b0, blit_busy & ~busy_late, blit_zero, dmacon[12:0]};
 	else                                dmaconr = 0;
 end
 
