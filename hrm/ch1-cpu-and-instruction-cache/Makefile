# NanoMig checkout location; default is this repo's submodule.
NANOMIG ?= ../../nanomig

# TOP is cpu_cache_new, NOT cpu_wrapper, even though cpu_wrapper is this
# package's assigned top module. Why: see SPECIFICATION.md "Boundary
# actually used" and this package's own test source header. In short --
#   1. cpu_wrapper's chip/ram-bus ports (chip_addr, chip_din, chip_rw,
#      chip_uds, chip_lds, chip_as, ramreq, ramaddr, ramdin, ramlds, ramuds,
#      cacr, ...) are ALL `output`/`output reg` (cpu_wrapper.v:60-98) --
#      there is no address-input port. Every one of those signals is
#      generated by the fx68k/TG68K core cpu_wrapper instantiates
#      internally, from whatever instructions that core fetches and
#      executes. Reaching a specific address (e.g. $E80000 for AUTOCONFIG,
#      $200000 for Zorro-II Fast RAM) requires the embedded CPU core to
#      execute real 68000 opcodes -- exactly the condition the task brief
#      calls a HALT ("No port of cpu_wrapper carries an opcode. If a claim
#      needs one, that is a HALT, not something to solve by reaching
#      outside.").
#   2. A build option, not a second reason: the real fx68k core
#      cpu_wrapper.v:473 instantiates ($(NANOMIG)/src/fx68k/fx68k.sv,
#      fx68kAlu.sv, uaddrPla.sv) fails this project's own Verilator 5.052
#      under its default checks -- `%Error-BLKANDNBLK: fx68k.sv:293:
#      Unsupported: Blocking and non-blocking assignments to same non-packed
#      variable: 'cpu_wrapper.cpu_inst_o.Nanod'` on a plain --lint-only run,
#      measured directly, not assumed. NanoMig's own sim/Makefile waives it
#      with -Wno-BLKANDNBLK, and so built fx68k runs with --no-assert (see
#      the test source). A Verilator-adapted fork of fx68k exists at
#      $(NANOMIG)/sim/fx68x_verilator/ (fx68k_flat.sv etc.), but it is a
#      materially different rewrite of the core (whole-file diff against
#      src/fx68k/fx68k.sv, not a drop-in patch) -- substituting it would
#      measure a different implementation than the one cpu_wrapper.v:473
#      actually instantiates, so this package does not use it.
# cpu_cache_new is the package's only actually-instantiated top; it is also
# what the claims file's own classify.observable field names for the two
# claims this package can grade (sol/opus:1-guidelines.c70,
# opus:1-guidelines.c75 -- "observable: yes, at cpu_cache_new"). The other
# 12 claims are RECORDED (not graded) by this same binary -- see the test
# source's own HALT section.
TOP := cpu_cache_new
SRC := $(NANOMIG)/src/minimig-aga/cpu_cache_new.v \
       $(NANOMIG)/src/minimig-aga/dpram.v \
       $(NANOMIG)/src/minimig-aga/dpram_be_1024x16.v
TEST_SRC := test_ch1-cpu-and-instruction-cache.cpp
OBJ_DIR := obj_dir
TEST_BIN := $(OBJ_DIR)/V$(TOP)

VERILATOR ?= verilator
FLAGS := --no-timing --cc --exe --build -j 0 -Wall -Wno-fatal -Wno-pinmissing -Wno-lint

# Pass MUT=<NAME> on the make command line to build one mutation variant,
# e.g. `make MUT=MUT_HIT test`. Unset/empty MUT builds the unmutated
# (baseline) binary. Each variant is a full separate build+run -- there is
# no shared state between them.
MUT ?=
ifneq ($(MUT),)
FLAGS += -CFLAGS -D$(MUT)=1
endif

.PHONY: all test build clean

all: test

build: $(SRC) $(TEST_SRC) Makefile
	rm -rf $(OBJ_DIR)
	$(VERILATOR) $(FLAGS) --Mdir $(OBJ_DIR) --top-module $(TOP) $(SRC) $(TEST_SRC)

# test always rebuilds from scratch, regardless of MUT, so a stale binary
# from a previous MUT value can never be silently re-run and reported as a
# different variant's result.
test: $(SRC) $(TEST_SRC) Makefile
	rm -rf $(OBJ_DIR)
	$(VERILATOR) $(FLAGS) --Mdir $(OBJ_DIR) --top-module $(TOP) $(SRC) $(TEST_SRC)
	./$(TEST_BIN)

clean:
	rm -rf $(OBJ_DIR)
